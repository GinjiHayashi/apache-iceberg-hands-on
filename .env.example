# ローカル専用の固定値。cp .env.example .env で使う。実在の認証情報は書かない。

# RustFS（S3 互換ストレージ）の管理者キー。S3 ブラウザ（s3manager）もこのキーで接続する
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# PostgreSQL（Polaris のメタデータ保存先）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Polaris の root プリンシパル（初期設定だけに使う）
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=s3cr3t

# Spark / Trino / PyIceberg が Polaris に接続するときのプリンシパル
POLARIS_CLIENT_ID=handson-client
POLARIS_CLIENT_SECRET=handson-secret
